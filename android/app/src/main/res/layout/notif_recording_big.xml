<?xml version="1.0" encoding="utf-8"?>
<!--
  録音中の通知（広げた状態）。
  たたんだ状態と同じ「ゲージ / 録音時間 / 一時停止・録音完了」の並びのまま、
  状態の説明を1行足してゲージを大きく見せる。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/notif_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Compat.Notification" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/notif_gauge"
            android:layout_width="96dp"
            android:layout_height="38dp"
            android:layout_marginEnd="12dp"
            android:scaleType="fitXY"
            android:contentDescription="@string/notif_rec_gauge" />

        <TextView
            android:id="@+id/notif_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

        <ImageView
            android:id="@+id/notif_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:padding="11dp"
            android:background="@drawable/bg_notif_btn"
            android:src="@drawable/ic_notif_pause"
            android:contentDescription="@string/notif_rec_pause" />

        <ImageView
            android:id="@+id/notif_stop"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:padding="10dp"
            android:background="@drawable/bg_notif_btn_stop"
            android:src="@drawable/ic_notif_stop"
            android:contentDescription="@string/notif_rec_stop" />
    </LinearLayout>
</LinearLayout>
