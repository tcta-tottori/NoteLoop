<?xml version="1.0" encoding="utf-8"?>
<!--
  録音中のステータスバー / 通知用アイコン。
  アプリの録音ボタン（icons/mic-white.png）と同じ形にそろえてある:
    丸い頭のマイク本体 + 下向きの受け（アーク） + スタンドの脚。
  SystemUI が白に着色して表示する。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">
    <!-- マイク本体（角丸のカプセル） -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,2.2c-1.66,0 -3,1.34 -3,3v5.9c0,1.66 1.34,3 3,3s3,-1.34 3,-3V5.2c0,-1.66 -1.34,-3 -3,-3z" />
    <!-- 受け（下向きのアーク） -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.9"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M18.2,10.6v0.8c0,3.42 -2.78,6.2 -6.2,6.2s-6.2,-2.78 -6.2,-6.2v-0.8" />
    <!-- スタンドの脚 -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.9"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M12,17.6v4.2" />
</vector>
