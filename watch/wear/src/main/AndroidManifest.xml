<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <!-- 録音 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 録音中のフォアグラウンドサービス（Android 14+ はマイク種別の宣言が必須） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- 録音中の常駐通知（Ongoing Activity） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 録音中に CPU を眠らせない -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".NoteLoopWearApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="true" />

        <!-- 録音は時計の中で完結する（スマホ無しで動く）。「スマホへ送る」だけスマホの NOTELOOP が要る -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 時計のマイクで録音するフォアグラウンドサービス -->
        <service
            android:name=".record.RecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- タイル（ウィジェット）: 大きなボタン 1 つで録音開始 / 録音中は経過時間 -->
        <service
            android:name=".tile.RecordTileService"
            android:exported="true"
            android:label="@string/tile_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

    </application>

</manifest>
